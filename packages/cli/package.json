{
  "name": "@storyforge/cli",
  "version": "0.1.0",
  "description": "Storyforge CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "storyforge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm --dir ../.. exec eslint --config ./eslint.config.mjs ./packages/cli/src ./test ./vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "pnpm --dir ../.. exec vitest run --config ./vitest.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "ink-gradient": "^4.0.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
